# LinkDB Environment Configuration
# Copy this file to .env and update values for your environment

# =====================
# Application Settings
# =====================
APP_NAME="LinkDB Analytics API"
APP_VERSION="2.0.0"
DEBUG=false
ENVIRONMENT=production  # development, staging, or production

# =====================
# Database
# =====================
DATABASE_URL=sqlite:///./data/output/linkops_history.db

# =====================
# Security
# =====================
# IMPORTANT: Generate a strong random secret key for production!
# You can generate one with: openssl rand -hex 32
SECRET_KEY=your-secret-key-here-change-this-in-production

# JWT Algorithm
ALGORITHM=HS256

# Access token expiration in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# =====================
# CORS (Cross-Origin Resource Sharing)
# =====================
# Comma-separated list of allowed origins
# Example for production: https://linkdb.yourcompany.com,https://app.yourcompany.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# =====================
# Rate Limiting
# =====================
# Maximum requests per minute per IP
RATE_LIMIT_PER_MINUTE=100

# =====================
# Logging
# =====================
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=logs/linkdb.log
LOG_MAX_BYTES=10485760  # 10MB
LOG_BACKUP_COUNT=5

# =====================
# API Configuration
# =====================
API_V1_PREFIX=/api/v1

# =====================
# Cache Settings
# =====================
# Cache time-to-live in seconds
CACHE_TTL_SECONDS=300  # 5 minutes

# Maximum number of cached items
CACHE_MAX_SIZE=1000

# =====================
# Email (for scheduled reports and notifications)
# =====================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@linkdb.com

# =====================
# Pagination
# =====================
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=100

# =====================
# Notes
# =====================
# - Never commit the .env file to version control
# - Update SECRET_KEY with a strong random value in production
# - Set DEBUG=false in production
# - Update ALLOWED_ORIGINS with your actual domain(s)
# - For Gmail SMTP, use an "App Password" not your regular password
